{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.val() != null"
      }
    },
    "rankings": {
      "$category": {
        ".read": true,
        "$playerKey": {
          ".write": true,
          ".validate": "newData.hasChildren(['username', 'score']) && newData.child('username').isString() && newData.child('username').val().length <= 16 && newData.child('score').isNumber()"
        }
      }
    },
    "users": {
      "$username": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['deviceId']) && newData.child('deviceId').isString()"
      }
    },
    "meta": {
      ".read": true,
      ".write": true,
      ".validate": "newData.val() != null"
    },
    "multiWins": {
      ".read": true,
      "$playerKey": {
        ".write": true,
        ".validate": "newData.hasChildren(['username', 'wins']) && newData.child('username').isString() && newData.child('wins').isNumber()"
      }
    }
  }
}
